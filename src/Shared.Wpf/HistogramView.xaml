<UserControl x:Class="RawBufferVisualizer.Presentation.HistogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RawBufferVisualizer.Presentation"
             AutomationProperties.AutomationId="HistogramView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/RawBufferVisualizerDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="HistogramVisibility"/>
            <Style x:Key="HistogramOptionalText" TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel>
            <TextBlock Text="Histogram" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"/>
            <Button x:Name="HistogramAction" Content="{Binding ActionText}" Command="{Binding ActionCommand}" Margin="0,0,0,4"
                    Style="{StaticResource RbvButtonStyle}"
                    AutomationProperties.AutomationId="HistogramAction" AutomationProperties.Name="{Binding ActionText}"/>
        </WrapPanel>
        <WrapPanel Visibility="{Binding HasChannels, Converter={StaticResource HistogramVisibility}}" Margin="0,2,0,4">
            <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="HistogramChannel" ItemsSource="{Binding Channels}" SelectedIndex="{Binding SelectedChannelIndex, Mode=TwoWay}"
                      Style="{StaticResource RbvComboBoxStyle}"
                      MinWidth="104" Margin="0" AutomationProperties.Name="Histogram channel" AutomationProperties.AutomationId="HistogramChannel"/>
        </WrapPanel>
        <TextBlock x:Name="HistogramSourceDescription" Text="{Binding SourceDescription}" Style="{StaticResource HistogramOptionalText}" Margin="0,2,0,6"/>
        <TextBlock x:Name="HistogramFrequencyScale" Text="{Binding FrequencyScale}" Style="{StaticResource HistogramOptionalText}" Margin="0,0,0,4"/>
        <Border Height="100" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <local:HistogramPlot x:Name="HistogramCanvas" Histogram="{Binding Result}" PlotBrush="{DynamicResource MutedTextBrush}"
                                 Margin="6" AutomationProperties.AutomationId="HistogramCanvas"/>
        </Border>
        <Grid Margin="0,3,0,5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LowerLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HistogramLowerLabel" Text="{Binding LowerLabel}" TextWrapping="Wrap" Margin="0,0,4,0"/>
            <TextBlock x:Name="HistogramUpperLabel" Grid.Column="1" Text="{Binding UpperLabel}" TextWrapping="Wrap" TextAlignment="Right" Margin="4,0,0,0"/>
        </Grid>
        <TextBlock x:Name="HistogramAxisDescription" Text="{Binding AxisDescription}" Style="{StaticResource HistogramOptionalText}" Margin="0,0,0,4"/>
        <TextBlock x:Name="HistogramCoverage" Text="{Binding Coverage}" Style="{StaticResource HistogramOptionalText}" AutomationProperties.AutomationId="HistogramCoverage"/>
        <TextBlock x:Name="HistogramValueRange" Text="{Binding ValueRange}" Style="{StaticResource HistogramOptionalText}"/>
        <TextBlock x:Name="HistogramExclusions" Text="{Binding Exclusions}" Style="{StaticResource HistogramOptionalText}"/>
        <TextBlock x:Name="HistogramSamplingDescription" Text="{Binding SamplingDescription}" Style="{StaticResource HistogramOptionalText}" Margin="0,4,0,0"/>
        <TextBlock x:Name="HistogramChannelDescription" Text="{Binding ChannelDescription}" Style="{StaticResource HistogramOptionalText}" Margin="0,4,0,0"/>
        <TextBlock x:Name="HistogramStatus" Text="{Binding Status}" Style="{StaticResource HistogramOptionalText}" AutomationProperties.AutomationId="HistogramStatus"/>
    </StackPanel>
</UserControl>
