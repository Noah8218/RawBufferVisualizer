<UserControl x:Class="RawBufferVisualizer.Presentation.HistogramView" x:Name="HistogramRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RawBufferVisualizer.Presentation"
             AutomationProperties.AutomationId="HistogramView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/RawBufferVisualizerDark.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="HistogramVisibility"/>
            <DataTemplate x:Key="DockedHistogramActionTemplate">
                <StackPanel Orientation="Horizontal"><Viewbox Width="12" Height="12" Margin="0,0,6,0"><Viewbox.Style><Style TargetType="Viewbox"><Style.Triggers><DataTrigger Binding="{Binding}" Value="Cancel"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="16" Height="16"><Path Data="{DynamicResource IconRefreshGeometry}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel>
            </DataTemplate>
            <Style x:Key="HistogramOptionalText" TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="Auto"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Width" Value="*"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                <ColumnDefinition Width="Auto"/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Histogram" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Grid.Column="1" x:Name="HistogramAction" Content="{Binding ActionText}" Command="{Binding ActionCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="HistogramAction" AutomationProperties.Name="{Binding ActionText}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RbvButtonStyle}"><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Background" Value="{DynamicResource CommandBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Height" Value="20"/><Setter Property="MinHeight" Value="20"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="7,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Template" Value="{DynamicResource DockedCommandTemplate}"/><Setter Property="ContentTemplate" Value="{StaticResource DockedHistogramActionTemplate}"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <WrapPanel Visibility="{Binding HasChannels, Converter={StaticResource HistogramVisibility}}">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Margin" Value="0,2,0,4"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <ComboBox x:Name="HistogramChannel" ItemsSource="{Binding Channels}" SelectedIndex="{Binding SelectedChannelIndex, Mode=TwoWay}" Margin="0" AutomationProperties.Name="Histogram channel" AutomationProperties.AutomationId="HistogramChannel" ToolTip="{Binding ChannelDescription}">
                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource RbvComboBoxStyle}"><Setter Property="MinWidth" Value="104"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Template" Value="{DynamicResource ChannelSegmentsTemplate}"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="MinWidth" Value="0"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Padding" Value="0"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"/><Condition Binding="{Binding}" Value="RGB mean"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="GV"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
        </Grid>
<TextBlock x:Name="HistogramSourceDescription" Text="{Binding SourceDescription}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="1"/><Setter Property="Margin" Value="0,2,0,6"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramFrequencyScale"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Text" Value="{Binding FrequencyScale}"/><Setter Property="Grid.Row" Value="2"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Text" Value="{Binding DockedFrequencyScale}"/><Setter Property="LineHeight" Value="16.675"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="Grid.Row" Value="5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Border Grid.Row="3" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="{DynamicResource BorderBrush}">
            <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="100"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Height" Value="102"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,12,0,0"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"/><Condition Binding="{Binding HasSource}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Viewbox Stretch="Fill" Margin="6,6,6,0"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="256" Height="96"><Line X1="0" X2="256" Y1="0" Y2="0" Stroke="{DynamicResource BorderBrush}"/><Line X1="0" X2="256" Y1="24" Y2="24" Stroke="{DynamicResource BorderBrush}" StrokeDashArray="2,3"/><Line X1="0" X2="256" Y1="48" Y2="48" Stroke="{DynamicResource BorderBrush}" StrokeDashArray="2,3"/><Line X1="0" X2="256" Y1="72" Y2="72" Stroke="{DynamicResource BorderBrush}" StrokeDashArray="2,3"/><Line X1="0" X2="256" Y1="96" Y2="96" Stroke="{DynamicResource BorderBrush}"/></Canvas></Viewbox>
                <local:HistogramPlot x:Name="HistogramCanvas" Histogram="{Binding Result}" AutomationProperties.AutomationId="HistogramCanvas">
                    <local:HistogramPlot.Style><Style TargetType="local:HistogramPlot"><Setter Property="Margin" Value="6"/><Setter Property="PlotBrush" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Margin" Value="6,6,6,0"/><Setter Property="FillArea" Value="True"/><Setter Property="PlotBrush" Value="#D4D4D4"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"/><Condition Binding="{Binding SelectedChannelIndex}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="PlotBrush" Value="#E06C75"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"/><Condition Binding="{Binding SelectedChannelIndex}" Value="2"/></MultiDataTrigger.Conditions><Setter Property="PlotBrush" Value="#98C379"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"/><Condition Binding="{Binding SelectedChannelIndex}" Value="3"/></MultiDataTrigger.Conditions><Setter Property="PlotBrush" Value="#61AFEF"/></MultiDataTrigger></Style.Triggers></Style></local:HistogramPlot.Style>
                </local:HistogramPlot>
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,5"/><Style.Triggers><DataTrigger Binding="{Binding LowerLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Margin" Value="6,0,6,0"/><Setter Property="Height" Value="18"/><Setter Property="TextElement.FontSize" Value="10"/><Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Width" Value="*"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HistogramLowerLabel" TextWrapping="Wrap" Margin="0,0,4,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Setter Property="Text" Value="{Binding LowerLabel}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Text" Value="{Binding DockedLowerLabel}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Grid.Column="1" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding MiddleLabel}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Text" Value="{Binding DockedMiddleLabel}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock x:Name="HistogramUpperLabel" Grid.Column="2" TextWrapping="Wrap" TextAlignment="Right" Margin="4,0,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Setter Property="Text" Value="{Binding UpperLabel}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Text" Value="{Binding DockedUpperLabel}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
<TextBlock x:Name="HistogramAxisDescription" Text="{Binding AxisDescription}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="5"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramCoverage" AutomationProperties.AutomationId="HistogramCoverage"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Text" Value="{Binding Coverage}"/><Setter Property="Grid.Row" Value="6"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="Text" Value="{Binding DockedCoverage}"/><Setter Property="LineHeight" Value="18"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramValueRange"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Text" Value="{Binding ValueRange}"/><Setter Property="Grid.Row" Value="7"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/><Setter Property="Text" Value="{Binding DockedValueRange}"/><Setter Property="LineHeight" Value="18"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramExclusions" Text="{Binding Exclusions}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="8"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramSamplingDescription" Text="{Binding SamplingDescription}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="9"/><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramChannelDescription" Text="{Binding ChannelDescription}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="10"/><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock x:Name="HistogramStatus" AutomationProperties.AutomationId="HistogramStatus" Text="{Binding Status}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistogramOptionalText}"><Setter Property="Grid.Row" Value="11"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=HistogramRoot}" Value="Docked"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
</UserControl>
