<Window x:Class="RawBufferVisualizer.Presentation.SnapshotExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Save Snapshot" Width="520" MinWidth="320" SizeToContent="Height"
        FocusManager.FocusedElement="{Binding ElementName=ExportCancel}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource RbvWindowBrush}" Foreground="{DynamicResource RbvTextBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/RawBufferVisualizerDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource RbvScrollBarStyle}"/>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock x:Name="ExportStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="ExportPath" Text="{Binding Path}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource RbvMutedTextBrush}"/>
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                         Height="16" Margin="0,0,0,8" AutomationProperties.Name="Snapshot export progress">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource RbvInputBrush}" BorderBrush="{DynamicResource RbvBorderBrush}" BorderThickness="1">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource RbvAccentBrush}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
            <TextBlock x:Name="ExportByteCount" Text="{Binding ByteCount}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button x:Name="ExportCancel" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource RbvButtonStyle}" HorizontalAlignment="Right" MinWidth="80" Margin="0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
