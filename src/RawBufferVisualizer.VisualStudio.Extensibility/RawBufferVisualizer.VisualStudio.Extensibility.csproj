<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <CreateVsixContainer>false</CreateVsixContainer>
    <AssemblyVSIXSubPath>OutOfProc</AssemblyVSIXSubPath>
    <AssemblyVersion>2.0.8.0</AssemblyVersion>
    <FileVersion>2.0.8.0</FileVersion>
    <Version>2.0.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.9.2092" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.9.2092" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="DockedVisualizerControl.xaml" />
    <EmbeddedResource Include="DockedVisualizerControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RawBufferVisualizer.Core\RawBufferVisualizer.Core.csproj" />
    <ProjectReference Include="..\RawBufferVisualizer.Sdk\RawBufferVisualizer.Sdk.csproj" />
    <ProjectReference Include="..\RawBufferVisualizer.VisualStudio\RawBufferVisualizer.VisualStudio.csproj" />
    <ProjectReference Include="..\RawBufferVisualizer.VisualStudio.ObjectSource\RawBufferVisualizer.VisualStudio.ObjectSource.csproj" />
  </ItemGroup>

  <Target Name="BuildObjectSourceForVsix" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\RawBufferVisualizer.VisualStudio.ObjectSource\RawBufferVisualizer.VisualStudio.ObjectSource.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
    <PropertyGroup>
      <_ObjectSourceVsixOutputDirectory>$(BaseOutputPath)..\RawBufferVisualizer.VisualStudio.ObjectSource\$(Configuration)\netstandard2.0</_ObjectSourceVsixOutputDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ObjectSourceVsixOutputDirectory)\RawBufferVisualizer.VisualStudio.ObjectSource.dll')"
           Text="The netstandard2.0 debugger object source was not built for the VSIX." />
    <ItemGroup>
      <_ObjectSourceVsixPayload Include="$(_ObjectSourceVsixOutputDirectory)\*.dll" />
      <_ObjectSourceVsixPayload Include="$(_ObjectSourceVsixOutputDirectory)\*.deps.json" />
      <Content Include="@(_ObjectSourceVsixPayload)">
        <Link>netstandard2.0\%(_ObjectSourceVsixPayload.Filename)%(_ObjectSourceVsixPayload.Extension)</Link>
        <VSIXSubPath>netstandard2.0</VSIXSubPath>
        <IncludeInVSIX>true</IncludeInVSIX>
        <Visible>false</Visible>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
