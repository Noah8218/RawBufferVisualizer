<Window x:Class="RawBufferVisualizer.VisualStudio.Vssdk.TypeMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Your Buffer"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RbvWindowBrush}"
        Foreground="{DynamicResource RbvTextBrush}"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RawBufferVisualizerDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RbvTextBlockStyle}"/>
            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource RbvLabelStyle}"/>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource RbvButtonStyle}"/>
            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource RbvToggleButtonStyle}"/>
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource RbvComboBoxStyle}"/>
            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource RbvComboBoxItemStyle}"/>
            <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource RbvListBoxStyle}"/>
            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource RbvListBoxItemStyle}"/>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource RbvScrollBarStyle}"/>
            <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource RbvToolTipStyle}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="640" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,10">
            <TextBlock x:Name="TypeNameText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Reads fields and property getters only. Methods are never invoked."
                       Foreground="{StaticResource RbvMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <TextBlock x:Name="MappingGuidanceText"
                       Foreground="{StaticResource RbvAttentionTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <Grid x:Name="AllRolesGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Data *" Target="{Binding ElementName=DataBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DataBox" AutomationProperties.AutomationId="MappingDataBox" Margin="0,0,0,6"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Width *" Target="{Binding ElementName=WidthBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="WidthBox" AutomationProperties.AutomationId="MappingWidthBox" Margin="0,0,0,6"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Height *" Target="{Binding ElementName=HeightBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HeightBox" AutomationProperties.AutomationId="MappingHeightBox" Margin="0,0,0,6"/>
                <Label Grid.Row="3" Grid.Column="0" Content="Stride" Target="{Binding ElementName=StrideBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="StrideBox" AutomationProperties.AutomationId="MappingStrideBox" Margin="0,0,0,6"/>
                <Label Grid.Row="4" Grid.Column="0" Content="Pixel Format" Target="{Binding ElementName=PixelFormatBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PixelFormatBox" AutomationProperties.AutomationId="MappingPixelFormatBox" Margin="0,0,0,6" SelectionChanged="PixelFormatBox_SelectionChanged"/>
                <Label Grid.Row="5" Grid.Column="0" Content="Buffer Length" Target="{Binding ElementName=BufferLengthBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="BufferLengthBox" AutomationProperties.AutomationId="MappingBufferLengthBox" Margin="0,0,0,6"/>
                <Label Grid.Row="6" Grid.Column="0" Content="Valid Bits" Target="{Binding ElementName=ValidBitsBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ValidBitsBox" AutomationProperties.AutomationId="MappingValidBitsBox" Margin="0,0,0,6"/>
                <Label Grid.Row="7" Grid.Column="0" Content="Byte Order" Target="{Binding ElementName=ByteOrderBox}" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="ByteOrderBox" AutomationProperties.AutomationId="MappingByteOrderBox" Margin="0,0,0,6"/>
            </Grid>

            <StackPanel x:Name="EnumMappingPanel" AutomationProperties.AutomationId="EnumMappingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="Pixel format value mapping" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel x:Name="EnumMappingRows" AutomationProperties.AutomationId="EnumMappingRows"/>
            </StackPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="PreviewButton" Content="Preview" AutomationProperties.AutomationId="PreviewMappingButton" Click="Preview_Click"/>
                <ToggleButton x:Name="DiagnoseInterpretationButton"
                              Content="Diagnose interpretation"
                              AutomationProperties.Name="Show or hide ranked buffer interpretations"
                              AutomationProperties.AutomationId="DiagnoseMappingInterpretationButton"
                              ToolTip="Suggest ranked interpretations from the current paused buffer"
                              Checked="DiagnoseInterpretation_Changed"
                              Unchecked="DiagnoseInterpretation_Changed"/>
                <Button x:Name="CopyTemplateButton" Content="Copy RawBufferView Template" AutomationProperties.AutomationId="CopyRawBufferViewTemplateButton" Click="CopyTemplate_Click"/>
                <Button x:Name="UseSuggestedRolesButton" Content="Use Suggested Roles" AutomationProperties.AutomationId="UseSuggestedMappingRolesButton" Click="UseSuggestedRoles_Click"/>
            </WrapPanel>

            <Border x:Name="DiagnosisResultPanel"
                    Visibility="Collapsed"
                    Margin="0,4,0,0"
                    Padding="8"
                    Background="{StaticResource RbvInputBrush}"
                    BorderBrush="{StaticResource RbvBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Suggested interpretations" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DiagnosisStatusText"
                               Margin="0,5,0,6"
                               Foreground="{StaticResource RbvMutedTextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="MappingDiagnosisStatusText"/>
                    <ListBox x:Name="DiagnosisCandidateList"
                              MaxHeight="140"
                              AutomationProperties.Name="Ranked buffer interpretations"
                              AutomationProperties.AutomationId="MappingDiagnosisCandidateList"
                              SelectionChanged="DiagnosisCandidateList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource RbvListBoxItemStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ReasonsText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource RbvAccentBrush}"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            CornerRadius="2"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource RbvMutedTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AmbiguityNote}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource RbvAttentionTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding AmbiguityVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DiagnosisApplyStatusText"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource RbvAttentionTextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="MappingDiagnosisApplyStatusText"/>
                </StackPanel>
            </Border>

            <Border Margin="0,4,0,0" Padding="6" Background="#111111" BorderBrush="{StaticResource RbvBorderBrush}" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Image x:Name="PreviewImage"
                           DockPanel.Dock="Left"
                           Width="160"
                           Height="100"
                           Margin="0,0,10,0"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="MappingPreviewImage"/>
                    <TextBlock x:Name="PreviewStatusText"
                               Foreground="{StaticResource RbvMutedTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="MappingPreviewStatusText"/>
                </DockPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1"
                Padding="14,8,14,8"
                Background="{StaticResource RbvPanelBrush}"
                BorderBrush="{StaticResource RbvBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource RbvAttentionTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel>
                <Button x:Name="SaveButton" Content="Save Mapping" AutomationProperties.AutomationId="SaveMappingButton" Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" AutomationProperties.AutomationId="CancelMappingButton" Click="Cancel_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
