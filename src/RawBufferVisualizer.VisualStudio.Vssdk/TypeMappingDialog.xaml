<Window x:Class="RawBufferVisualizer.VisualStudio.Vssdk.TypeMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map This Type"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="660" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock x:Name="TypeNameText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Reads fields and property getters only. Methods are never invoked."
                       Foreground="#9CDCFE" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <TextBlock x:Name="MappingGuidanceText"
                       Foreground="#D7BA7D"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <Grid x:Name="AllRolesGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Data *" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DataBox" AutomationProperties.AutomationId="MappingDataBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width *" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="WidthBox" AutomationProperties.AutomationId="MappingWidthBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Height *" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HeightBox" AutomationProperties.AutomationId="MappingHeightBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Stride" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="StrideBox" AutomationProperties.AutomationId="MappingStrideBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Pixel Format" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PixelFormatBox" AutomationProperties.AutomationId="MappingPixelFormatBox" Margin="0,0,0,6" SelectionChanged="PixelFormatBox_SelectionChanged"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Buffer Length" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="BufferLengthBox" AutomationProperties.AutomationId="MappingBufferLengthBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Valid Bits" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ValidBitsBox" AutomationProperties.AutomationId="MappingValidBitsBox" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Byte Order" Margin="0,0,8,6" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="ByteOrderBox" AutomationProperties.AutomationId="MappingByteOrderBox" Margin="0,0,0,6"/>
            </Grid>

            <StackPanel x:Name="EnumMappingPanel" AutomationProperties.AutomationId="EnumMappingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="Pixel format value mapping" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel x:Name="EnumMappingRows" AutomationProperties.AutomationId="EnumMappingRows"/>
            </StackPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="PreviewButton" Content="Preview" AutomationProperties.AutomationId="PreviewMappingButton" ToolTip="Render a thumbnail from live debuggee memory when the data member is a pointer" Click="Preview_Click"/>
                <Button x:Name="SaveButton" Content="Save for This Type" AutomationProperties.AutomationId="SaveMappingButton" Click="Save_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" AutomationProperties.AutomationId="CancelMappingButton" Click="Cancel_Click"/>
            </WrapPanel>

            <Border Margin="0,10,0,0" Padding="6" Background="#111111" BorderBrush="#3C3C3C" BorderThickness="1">
                <StackPanel>
                    <Image x:Name="PreviewImage"
                           Width="192"
                           Height="144"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="MappingPreviewImage"/>
                    <TextBlock x:Name="PreviewStatusText"
                               Foreground="#9CDCFE"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               AutomationProperties.AutomationId="MappingPreviewStatusText"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="#D7BA7D" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
