<Window x:Class="RawBufferVisualizer.VisualStudio.Vssdk.OpenVariableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Variable"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="Open a variable from the paused debuggee as an image." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Expression (evaluated in the current stack frame)" Foreground="#9CDCFE" Margin="0,10,0,4"/>
        <TextBox x:Name="ExpressionBox" AutomationProperties.AutomationId="OpenVariableExpressionBox" Margin="0,0,0,8" KeyDown="ExpressionBox_KeyDown"/>
        <TextBlock x:Name="RecentHeading" Text="Recent expressions" Foreground="#9CDCFE" Margin="0,0,0,4" Visibility="Collapsed"/>
        <ListBox x:Name="RecentList" MaxHeight="140" Margin="0,0,0,8" Visibility="Collapsed" SelectionChanged="RecentList_SelectionChanged"/>
        <WrapPanel>
            <Button x:Name="OpenButton" Content="Open" AutomationProperties.AutomationId="OpenVariableOpenButton" IsDefault="True" Click="Open_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" AutomationProperties.AutomationId="OpenVariableCancelButton" IsCancel="True" Click="Cancel_Click"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="OpenVariableStatusText" Foreground="#D7BA7D" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
