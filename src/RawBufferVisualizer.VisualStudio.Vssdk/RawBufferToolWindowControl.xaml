                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2"><ContentPresenter HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
                                    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CommandHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource CommandPressedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger></Style.Triggers>
                                </Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid ToolTip="{Binding ReasonsText}" AutomationProperties.Name="{Binding AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="64" Height="48" Background="{DynamicResource CanvasBrush}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,30,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" LineHeight="16.2" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" LineHeight="15.4" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AmbiguityNote}" FontSize="11" LineHeight="15.4" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0" Foreground="{DynamicResource AttentionTextBrush}" TextWrapping="Wrap" Visibility="{Binding AmbiguityVisibility}"/>
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="2" Width="24" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="2">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource CommandBrush}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsTop}" Value="True"><Setter Property="Background" Value="{DynamicResource StatusAccentBrush}"/><Setter Property="TextElement.Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="ApplyDiagnosisCandidateButton" Content="Apply candidate" Command="{Binding ApplyCandidateCommand}" Background="{DynamicResource StatusAccentBrush}" BorderBrush="{DynamicResource StatusAccentBrush}"/>
                                <Button x:Name="CloseDiagnosisButton" Content="Cancel preview" Margin="0" Command="{Binding CancelPreviewCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel></Border>
                    <Border x:Name="DescriptorPanel" Style="{StaticResource InspectorCard}" Margin="0,12,0,0" MaxHeight="160">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="DESCRIPTOR" Style="{StaticResource InspectorBlockHeading}" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DescriptorText" FontFamily="Cascadia Mono, Consolas" FontSize="11" LineHeight="16.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                    </StackPanel>
                    <StackPanel x:Name="CompareSection" Visibility="{Binding IsCompareSelected, Converter={StaticResource BooleanVisibility}}">
                        <Grid x:Name="CompareSlots" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="CompareASlot" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="6" Margin="0,0,0,6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="64" Height="48" Background="{DynamicResource CanvasBrush}" CornerRadius="2"><Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    <Viewbox Width="16" Height="16"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="16" Height="16"><Path Data="{StaticResource IconImageGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.5"/></Canvas></Viewbox>
                                    <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Background="{DynamicResource StatusAccentBrush}" CornerRadius="2"><TextBlock Text="A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </Grid></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource CompareSlotName}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"><Run Text="{Binding SizeText, Mode=OneWay}"/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=" · "/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Text" Value=""/></DataTrigger><DataTrigger Binding="{Binding FormatText}" Value=""><Setter Property="Text" Value=""/></DataTrigger></Style.Triggers></Style></Run.Style></Run><Run Text="{Binding FormatText, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" x:Name="CompareBSlot" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="6" Margin="0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="64" Height="48" Background="{DynamicResource CanvasBrush}" CornerRadius="2"><Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    <Viewbox Width="16" Height="16"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Canvas Width="16" Height="16"><Path Data="{StaticResource IconImageGeometry}" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.5"/></Canvas></Viewbox>
                                    <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Background="{DynamicResource StatusAccentBrush}" CornerRadius="2"><TextBlock Text="B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </Grid></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource CompareSlotName}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"><Run Text="{Binding SizeText, Mode=OneWay}"/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=" · "/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Text" Value=""/></DataTrigger><DataTrigger Binding="{Binding FormatText}" Value=""><Setter Property="Text" Value=""/></DataTrigger></Style.Triggers></Style></Run.Style></Run><Run Text="{Binding FormatText, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button x:Name="SwapCompareButton" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource ImageIconButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding SwapCommand}" ToolTip="Swap A and B" AutomationProperties.Name="Swap A and B">
                            <Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="M2.5 5.5H12.5 M10 3L12.5 5.5L10 8 M13.5 10.5H3.5 M6 8L3.5 10.5L6 13"/></Canvas></Viewbox>
                        </Button></Grid>
                        <WrapPanel x:Name="CompareSetActions" Margin="0,0,0,12">
                            <Button x:Name="SetCompareAButton" Content="Set current as A" Click="SetCompareA_Click"/>
                            <Button x:Name="SetCompareBButton" Content="Set current as B" Click="SetCompareB_Click" Margin="0"/>
                        </WrapPanel>
                        <WrapPanel x:Name="CompareViewActions" Margin="0,0,0,12">
                            <Button Click="ShowSplit_Click" AutomationProperties.Name="Split"><StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconSplitGeometry}"/></Canvas></Viewbox><TextBlock Text="Split"/></StackPanel></Button>
                            <Button Content="Diff" Click="ShowDiff_Click"/>
                            <Button x:Name="BlinkButton" Content="Blink" Click="Blink_Click" Margin="0">
                                <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Path x:Name="BlinkStateIcon" Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconPlayGeometry}"/></Canvas></Viewbox><TextBlock x:Name="BlinkStateCaption" Text="{Binding}"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding}" Value="Stop"><Setter TargetName="BlinkStateIcon" Property="Data" Value="{StaticResource IconStopGeometry}"/><Setter TargetName="BlinkStateCaption" Property="Text" Value="Stop blink"/></DataTrigger></DataTemplate.Triggers></DataTemplate></Button.ContentTemplate>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="CompareText" Margin="0,0,0,12" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="11.5"/>
                        <TextBlock x:Name="CompareCaptionText" Text="Split and Diff add a new image to the list. Turn on Link views to keep zoom and position while switching." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" LineHeight="16.675" LineStackingStrategy="BlockLineHeight" TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="DiagnosticsSection" Visibility="{Binding IsDiagnosticsSelected, Converter={StaticResource BooleanVisibility}}"><Border x:Name="EnvironmentCheckPanel" Visibility="Visible" Margin="0,0,0,12"
                            AutomationProperties.Name="Raw Buffer Visualizer environment check" AutomationProperties.AutomationId="EnvironmentCheckPanel">
                        <StackPanel TextOptions.TextFormattingMode="Ideal"><TextBlock Text="ENVIRONMENT" Style="{StaticResource InspectorBlockHeading}" Margin="0,0,0,8"/>
                            <Grid Tag="{Binding Tag, ElementName=EnvironmentVisualStudioText}" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top"><Canvas Width="16" Height="16"><Path Style="{StaticResource EnvironmentStatusIcon}"/></Canvas></Viewbox>
                                <TextBlock Grid.Column="2" x:Name="EnvironmentVisualStudioText" AutomationProperties.AutomationId="EnvironmentVisualStudioStatus" Text="Visual Studio host" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Tag="{Binding Tag, ElementName=EnvironmentExtensionText}" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top"><Canvas Width="16" Height="16"><Path Style="{StaticResource EnvironmentStatusIcon}"/></Canvas></Viewbox>
                                <TextBlock Grid.Column="2" x:Name="EnvironmentExtensionText" AutomationProperties.AutomationId="EnvironmentExtensionStatus" Text="Raw Buffer Visualizer" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Tag="{Binding Tag, ElementName=EnvironmentTempStorageText}"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Viewbox Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top"><Canvas Width="16" Height="16"><Path Style="{StaticResource EnvironmentStatusIcon}"/></Canvas></Viewbox>
                                <StackPanel Grid.Column="2"><TextBlock x:Name="EnvironmentTempStorageText" AutomationProperties.AutomationId="EnvironmentTempStorageStatus" Text="Temp storage" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TempUsageText" Visibility="Collapsed" AutomationProperties.AutomationId="TempUsageText"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Refresh" AutomationProperties.Name="Refresh environment check" AutomationProperties.AutomationId="EnvironmentCheckRefreshButton" Click="RefreshEnvironmentCheck_Click" Height="20" MinHeight="20" FontSize="11" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Top"/>
                            </Grid>
                            <Button Content="Copy diagnostic report" Visibility="Collapsed" AutomationProperties.Name="Copy environment diagnostic report" AutomationProperties.AutomationId="EnvironmentCheckCopyReportButton" Click="CopyEnvironmentReport_Click"/>
                        </StackPanel>
                    </Border>
<TextBlock Text="RENDERING" Style="{StaticResource InspectorBlockHeading}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PerformanceText" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext, ElementName=RenderingMetricsPanel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Grid x:Name="RenderingMetricsPanel" Margin="0,0,0,12">
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></Style></Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Frames drawn" Margin="0,0,10,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"><Run Text="{Binding FrameCount, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                        <TextBlock Grid.Row="1" Text="Max frame" Margin="0,0,10,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"><Run Text="{Binding MaxFrameMilliseconds, Mode=OneWay, StringFormat={}{0:0.0} ms}"/></TextBlock>
                        <TextBlock Grid.Row="2" Text="Wheel inputs" Margin="0,0,10,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"><Run Text="{Binding WheelInputCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" · max "/><Run Text="{Binding MaxWheelInputMilliseconds, Mode=OneWay, StringFormat={}{0:0.0} ms}"/></TextBlock>
                        <TextBlock Grid.Row="3" Text="Drag inputs" Margin="0,0,10,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"><Run Text="{Binding DragInputCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" · max "/><Run Text="{Binding MaxDragInputMilliseconds, Mode=OneWay, StringFormat={}{0:0.0} ms}"/></TextBlock>
                        <TextBlock Grid.Row="4" Text="Image uploads" Margin="0,0,10,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"><Run Text="{Binding TextureUploadCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" · max "/><Run Text="{Binding MaxTextureUploadMilliseconds, Mode=OneWay, StringFormat={}{0:0.0} ms}"/></TextBlock>
                    </Grid>
                    <TextBlock Text="LOG" Style="{StaticResource InspectorBlockHeading}" Margin="0,0,0,6"/>
                    <ListBox x:Name="DiagnosticsList" MaxHeight="150" MinHeight="40" Padding="8,6" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontFamily="Cascadia Mono, Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="16.5"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <WrapPanel Margin="0,0,0,6">
                        <Button ToolTip="Copy diagnostics and environment details without image data" AutomationProperties.Name="Copy report" Click="CopySupportReport_Click">
                            <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconCopyGeometry}"/></Canvas></Viewbox><TextBlock Text="Copy report"/></StackPanel>
                        </Button>
                        <Button ToolTip="Write the current report and open its log folder" AutomationProperties.Name="Open logs" Click="OpenSupportLogs_Click">
                            <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconFolderGeometry}"/></Canvas></Viewbox><TextBlock Text="Open logs folder"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="The report contains diagnostics and environment details, but no image payload." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" LineHeight="16.675" TextWrapping="Wrap"/>
                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </ContentControl>
            <StackPanel x:Name="InspectorRail" Grid.Column="5" Background="{DynamicResource ToolbarBrush}">
                <ToggleButton x:Name="InspectorPixelButton" IsChecked="{Binding IsPixelSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Pixel" AutomationProperties.Name="Pixel" AutomationProperties.AutomationId="InspectorPixelButton">
                    <StackPanel><Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconCrosshairGeometry}"/></Canvas></Viewbox><TextBlock Text="Pixel" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorHistogramButton" IsChecked="{Binding IsHistogramSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Histogram" AutomationProperties.Name="Histogram" AutomationProperties.AutomationId="InspectorHistogramButton">
                    <StackPanel><Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconBarChartGeometry}"/></Canvas></Viewbox><TextBlock Text="Histo" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorFormatButton" IsChecked="{Binding IsFormatSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Buffer format" AutomationProperties.Name="Buffer format" AutomationProperties.AutomationId="InspectorFormatButton">
                    <StackPanel><Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconSlidersGeometry}"/></Canvas></Viewbox><TextBlock Text="Format" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorCompareButton" IsChecked="{Binding IsCompareSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Compare" AutomationProperties.Name="Compare" AutomationProperties.AutomationId="InspectorCompareButton">
                    <StackPanel><Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconSplitGeometry}"/></Canvas></Viewbox><TextBlock Text="Compare" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorDiagnosticsButton" IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Diagnostics" AutomationProperties.Name="Diagnostics" AutomationProperties.AutomationId="InspectorDiagnosticsButton">
                    <StackPanel><Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="16" Height="16"><Path Style="{StaticResource PrototypeIcon}" Data="{StaticResource IconPulseGeometry}"/></Canvas></Viewbox><TextBlock Text="Diag" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
            </StackPanel>
            <Popup x:Name="ImageCardPopup" IsOpen="{Binding IsOpen, Mode=TwoWay}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" StaysOpen="False" Opened="PopupMenu_Opened" PreviewKeyDown="PopupMenu_PreviewKeyDown">
                <Border Style="{StaticResource PopupMenu}"><StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <Button Content="Save visible PNG" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="SaveVisiblePng"/>
                    <Button Content="Save raw snapshot…" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="SaveSnapshot"/>
                    <Button Content="Copy pointer address" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="CopyPointer"/>
                    <Button Content="Copy pixel address" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="CopyPixels"/>
                    <Button Content="Set as A" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="SetA"/>
                    <Button Content="Set as B" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="SetB"/>
                    <Separator Style="{StaticResource PopupMenuSeparator}"/>
                    <Button Content="Remove from list" Style="{StaticResource PopupMenuButton}" Command="{Binding ActionCommand}" CommandParameter="Remove"/>
                </StackPanel></Border>
            </Popup>
            <Popup x:Name="InspectorOverlayPopup" PlacementTarget="{Binding ElementName=InspectorRail}" Placement="Left" AllowsTransparency="True" StaysOpen="True" Opened="InspectorOverlay_Opened" PreviewKeyDown="InspectorOverlay_PreviewKeyDown"/>
            </Grid>




        </Grid>

    </Grid>
</UserControl>
