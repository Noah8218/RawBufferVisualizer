<UserControl x:Class="RawBufferVisualizer.VisualStudio.Vssdk.RawBufferToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gl="clr-namespace:RawBufferVisualizer.OpenGlCanvas;assembly=RawBufferVisualizer.OpenGlCanvas"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:presentation="clr-namespace:RawBufferVisualizer.Presentation"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             MinWidth="320"
             MinHeight="260"
             SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="CommandBrush" Color="#333337"/>
        <SolidColorBrush x:Key="CommandHoverBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="CommandPressedBrush" Color="#094771"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CDCFE"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3A7AE"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#252526"/>
        <SolidColorBrush x:Key="StatusAccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="StatusTextBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ChannelChipBrush" Color="#303033"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="SplitterHoverBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#B5CEA8"/>
        <SolidColorBrush x:Key="AttentionTextBrush" Color="#D7BA7D"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="{StaticResource PanelBrush}"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SplitterHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InspectorRailButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="54"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="ViewerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="1,2"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ViewerToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="1,2"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ViewerCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="1,2"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CommandPressedBrush}"/><Setter TargetName="CheckBorder" Property="BorderThickness" Value="1"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CommandPressedBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChannelChipBrush}"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/><Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="AutoScanSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <DockPanel><Border x:Name="SwitchTrack" DockPanel.Dock="Left" Width="26" Height="14" CornerRadius="7" Margin="0,0,6,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"><Ellipse x:Name="SwitchThumb" Width="10" Height="10" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Left" Margin="2"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource StatusAccentBrush}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource CommandPressedBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource TextBrush}"/><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ImageStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#89D185"/>
            <Style.Triggers><DataTrigger Binding="{Binding StateName}" Value="MAP"><Setter Property="Foreground" Value="#E2C08D"/></DataTrigger><DataTrigger Binding="{Binding StateName}" Value="FAILED"><Setter Property="Foreground" Value="#F48771"/></DataTrigger><DataTrigger Binding="{Binding StateName}" Value="PREVIEW"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="ImageCardStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid x:Name="CardBackground" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Stretch"/>
                    <Border x:Name="CardSelection" BorderThickness="2,0,0,0" BorderBrush="Transparent" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBackground" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBackground" Property="Background" Value="{DynamicResource CommandPressedBrush}"/><Setter TargetName="CardSelection" Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSelection" Property="BorderThickness" Value="1"/><Setter TargetName="CardSelection" Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource InputBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>





        <Grid x:Name="ResponsiveContentGrid" Grid.Row="0">


            <Grid x:Name="MainContentGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ImagesColumn" Width="320" MinWidth="160"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="140"/>
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="5"/>
                    <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="0"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

            <Grid x:Name="ImagesPanel" Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ImagePanelTop" Grid.Row="0">
<WrapPanel x:Name="ImageListHeader" Margin="8,4" VerticalAlignment="Center">
    <TextBlock x:Name="ImagesHeadingText" Text="Images" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Style="{StaticResource InfoChip}" VerticalAlignment="Center" Margin="6,0"><TextBlock x:Name="ImageCountText" FontSize="11" Text="0"/></Border>
    <ToggleButton x:Name="AddImageButton" Content="+" MinWidth="28" Width="28" Margin="0" Padding="4,2" ToolTip="Add image" AutomationProperties.Name="Add image" AutomationProperties.AutomationId="AddImageButton"/>
<Button x:Name="ClearButton"

                                Margin="0"
                                Padding="4,2" MinWidth="28"
                                ToolTip="Clear all images"
                                AutomationProperties.Name="Clear all images"
                                AutomationProperties.AutomationId="ClearButton"
                                Click="ReviewClear_Click">
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.ClearCollection}" Width="16" Height="16" />
                                <TextBlock x:Name="ClearButtonText" Text="Clear all" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
    <Button x:Name="CollapseImagesButton" Content="«" Command="{Binding ToggleImageListCommand}" MinWidth="28" Width="28" Margin="0" Padding="4,2" ToolTip="Collapse to thumbnails" AutomationProperties.Name="Collapse to thumbnails" AutomationProperties.AutomationId="CollapseImagesButton"/>
</WrapPanel>
    <Border x:Name="ClearAllConfirmation" Visibility="Collapsed" Margin="8,4" Padding="8" Background="{DynamicResource CommandBrush}" BorderBrush="#F48771" BorderThickness="1">
        <StackPanel><TextBlock x:Name="ClearAllConfirmationText" TextWrapping="Wrap" FontSize="11.5"/>
            <WrapPanel Margin="0,6,0,0"><Button x:Name="ConfirmClearAllButton" Content="Clear all" Click="Clear_Click" AutomationProperties.AutomationId="ConfirmClearAllButton"/><Button x:Name="CancelClearAllButton" Content="Cancel" Click="CancelClearAll_Click" AutomationProperties.AutomationId="CancelClearAllButton"/></WrapPanel>
        </StackPanel>
    </Border>
<StackPanel x:Name="AutomaticInspectionBar" Grid.Row="0" Margin="8,8,8,10">
                    <WrapPanel>
                        <Grid MaxWidth="{Binding ActualWidth, ElementName=AutomaticInspectionBar}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AutoInspectBox" Style="{StaticResource AutoScanSwitch}"
                                      IsChecked="True"
                                      Foreground="{StaticResource TextBrush}"
                                      VerticalAlignment="Center"
                                      ToolTip="Refresh image-like locals and arguments on Break. This choice is saved; the Tool Window is never forced open."
                                      AutomationProperties.Name="Automatic Vision Inspector"
                                      AutomationProperties.AutomationId="AutomaticVisionAutoInspectCheckBox"
                                      Checked="AutoInspectBox_Changed"
                                      Unchecked="AutoInspectBox_Changed">
                                <TextBlock Text="Auto scan on break" TextWrapping="Wrap"/>
                            </CheckBox>
                            <Button x:Name="AutomaticHelpButton" Grid.Column="1"
                                    Margin="4,0,0,0" Padding="3" MinWidth="24" Width="24" Height="24" VerticalAlignment="Center"
                                    AutomationProperties.Name="About automatic inspection"
                                    AutomationProperties.AutomationId="AutomaticVisionHelpButton"
                                    ToolTipService.InitialShowDelay="250"
                                    Click="AutomaticHelp_Click" PreviewKeyDown="AutomaticHelp_PreviewKeyDown">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusHelp}" Width="16" Height="16"/>
                                <Button.ToolTip>
                                    <ToolTip x:Name="AutomaticHelpTip" StaysOpen="False" MaxWidth="340"
                                             Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Automatic inspection" FontWeight="SemiBold"/>
                                            <TextBlock Text="Refresh image-like locals and arguments when the debugger pauses. This choice is saved. Scan Now works while paused, even with Auto Inspect off."
                                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="AutomaticFrameText" Text="{Binding Frame}" Margin="0,8,0,0"
                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="AutomaticScanStatusText" Text="{Binding Details}" Margin="0,5,0,0"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                        <Button x:Name="ScanNowButton"
                                IsEnabled="{Binding CanScan}"
                                Content="Scan now"
                                Margin="6,0,0,0"
                                ToolTip="Scan the current stack frame without waiting for another break"
                                AutomationProperties.AutomationId="AutomaticVisionScanNowButton"
                                Click="ScanNow_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="AutomaticCandidateCountText"
                               Visibility="Collapsed"
                               Margin="0,5,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="AutomaticVisionCandidateCount"/>
                    <WrapPanel x:Name="AutomaticScanProgressPanel"
                               Visibility="Collapsed"
                               Margin="0,5,0,0">
                        <TextBlock x:Name="AutomaticScanProgressText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="AutomaticVisionProgressText"/>
                        <Button x:Name="AutomaticStopButton"
                                Content="Stop"
                                Margin="6,0,0,0"
                                ToolTip="Stop after the current image; already refreshed rows remain available"
                                AutomationProperties.AutomationId="AutomaticVisionStopButton"
                                Click="StopAutomaticScan_Click"/>
                    </WrapPanel>
                    <DockPanel Margin="0,6,0,0"><Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding CanScan}" Value="True"><Setter Property="Fill" Value="#89D185"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock x:Name="StatusText"
                           Text="{Binding Status}" ToolTip="{Binding StatusDetails}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="StatusText"


                           Margin="0"
                           VerticalAlignment="Center"

                           Foreground="{StaticResource StatusTextBrush}"
                           FontSize="11.5"
                           TextWrapping="Wrap"/></DockPanel>
                    <TextBlock x:Name="AutomaticBatchSummaryText"
                               Visibility="Collapsed"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="AutomaticVisionBatchSummary"/>
                    <WrapPanel x:Name="AutomaticBatchActionsPanel"
                               Visibility="Collapsed"
                               Margin="0,5,0,0">
                        <Button x:Name="AutomaticLoadNextButton"
                                Content="Load next 8"
                                ToolTip="Refresh up to eight more images from this Break"
                                AutomationProperties.AutomationId="AutomaticVisionLoadNextButton"
                                Click="LoadNextAutomaticBatch_Click"/>
                        <Button x:Name="AutomaticLoadAllButton"
                                Content="Load all this Break"
                                ToolTip="Refresh every remaining detected image; Stop remains available"
                                AutomationProperties.AutomationId="AutomaticVisionLoadAllButton"
                                Click="LoadAllAutomaticBatch_Click"/>
                    </WrapPanel>

                </StackPanel>
</StackPanel>
<StackPanel x:Name="ImageStripHeader" Grid.Row="0" Visibility="Collapsed" Margin="4,4">
    <Button Content="»" Command="{Binding ToggleImageListCommand}" MinWidth="28" Margin="0" ToolTip="Expand image list" AutomationProperties.Name="Expand image list" AutomationProperties.AutomationId="ExpandImagesButton"/>
    <Button Content="↻" IsEnabled="{Binding IsEnabled, ElementName=ScanNowButton}" MinWidth="28" Margin="0,4,0,0" ToolTip="Scan now" AutomationProperties.Name="Scan now" Click="ScanNow_Click"/>
</StackPanel>
<Popup x:Name="AddImagePopup" PlacementTarget="{Binding ElementName=AddImageButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=AddImageButton, Mode=TwoWay}">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4"><StackPanel ButtonBase.Click="AddImageMenu_Click">
        <Button Content="Open snapshot file…" Click="Open_Click"/>
        <Button Content="Open variable…" Click="OpenVariable_Click"/>
        <Button Content="Connect your buffer…" Click="MapThisType_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=MapThisTypeMenuItem}" Value="Collapsed"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    </StackPanel></Border>
</Popup>

                    <ListBox Grid.Row="1" Margin="4,0,4,4" x:Name="ImageList" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ImageCardStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ImageList" SelectionChanged="ImageList_SelectionChanged" KeyDown="ImageList_KeyDown" ContextMenuOpening="ImageListContextMenu_Opening">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Save visible PNG" Click="SaveVisiblePng_Click"/>
                                <MenuItem Header="Save raw snapshot" Click="SaveSnapshot_Click"/>
                                <MenuItem x:Name="CopyPointerAddressMenuItem"
                                          Header="Copy pointer address"
                                          IsEnabled="False"
                                          AutomationProperties.Name="Copy pointer address"
                                          AutomationProperties.AutomationId="CopyPointerAddressMenuItem"
                                          Click="CopyPointerAddress_Click"/>
