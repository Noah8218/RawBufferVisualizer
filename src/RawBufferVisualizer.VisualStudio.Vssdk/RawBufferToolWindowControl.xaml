<UserControl x:Class="RawBufferVisualizer.VisualStudio.Vssdk.RawBufferToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gl="clr-namespace:RawBufferVisualizer.OpenGlCanvas;assembly=RawBufferVisualizer.OpenGlCanvas"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:presentation="clr-namespace:RawBufferVisualizer.Presentation"
             xmlns:local="clr-namespace:RawBufferVisualizer.VisualStudio.Vssdk"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}"
             TextOptions.TextFormattingMode="Ideal" MinWidth="320"
             MinHeight="260"
             SizeChanged="Root_SizeChanged" PreviewKeyDown="Root_PreviewKeyDown" PreviewMouseDown="Root_PreviewMouseDown">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/RawBufferVisualizerDark.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <local:ImageObjectCaptionConverter x:Key="ImageObjectCaption"/>
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="CommandBrush" Color="#333337"/>
        <SolidColorBrush x:Key="CommandHoverBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="CommandPressedBrush" Color="#094771"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A3A7AE"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3A7AE"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#252526"/>
        <SolidColorBrush x:Key="StatusAccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="StatusTextBrush" Color="#A3A7AE"/>
        <SolidColorBrush x:Key="ChannelChipBrush" Color="#333337"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SplitterHoverBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#89D185"/>
        <SolidColorBrush x:Key="AttentionTextBrush" Color="#E2C08D"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="FaintTextBrush" Color="#6E737B"/>
        <SolidColorBrush x:Key="LinkBrush" Color="#3794FF"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#141414"/>
        <SolidColorBrush x:Key="InfoTextBrush" Color="#75BEFF"/>
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#F48771"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
        <SolidColorBrush x:Key="RbvInputBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="RbvInputHoverBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="RbvBorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="RbvMutedTextBrush" Color="#A3A7AE"/>
        <SolidColorBrush x:Key="RbvAttentionTextBrush" Color="#E2C08D"/>
        <SolidColorBrush x:Key="RbvAccentHoverBrush" Color="#3794FF"/>
        <GeometryGroup x:Key="IconChevronDownGeometry"><PathGeometry Figures="M4 6.2l4 4 4-4"/></GeometryGroup>
        <GeometryGroup x:Key="IconChevronsLeftGeometry"><PathGeometry Figures="M8.5 4l-4 4 4 4M12.5 4l-4 4 4 4"/></GeometryGroup>
        <GeometryGroup x:Key="IconChevronsRightGeometry"><PathGeometry Figures="M7.5 4l4 4-4 4M3.5 4l4 4-4 4"/></GeometryGroup>
        <GeometryGroup x:Key="IconRefreshGeometry"><PathGeometry Figures="M13.3 8a5.3 5.3 0 1 1-1.7-3.9M13.4 2.6v3.2h-3.2"/></GeometryGroup>
        <GeometryGroup x:Key="IconPlusGeometry"><PathGeometry Figures="M8 3v10M3 8h10"/></GeometryGroup>
        <GeometryGroup x:Key="IconBarChartGeometry"><PathGeometry Figures="M2.5 13.5h11M4.5 13.5V8M8 13.5V3.5M11.5 13.5V6"/></GeometryGroup>
        <GeometryGroup x:Key="IconBoxGeometry"><RectangleGeometry Rect="2.5,2.5,11,11" RadiusX="1" RadiusY="1"/></GeometryGroup>
        <GeometryGroup x:Key="IconCopyGeometry"><RectangleGeometry Rect="5.5,5.5,8,8" RadiusX="1.2" RadiusY="1.2"/><PathGeometry Figures="M10.5 5.5v-2a1.2 1.2 0 0 0-1.2-1.2H3.7a1.2 1.2 0 0 0-1.2 1.2v5.6a1.2 1.2 0 0 0 1.2 1.2h1.8"/></GeometryGroup>
        <GeometryGroup x:Key="IconCrosshairGeometry"><EllipseGeometry Center="8,8" RadiusX="3.6" RadiusY="3.6"/><PathGeometry Figures="M8 1.8v3M8 11.2v3M1.8 8h3M11.2 8h3"/></GeometryGroup>
        <GeometryGroup x:Key="IconFitGeometry"><PathGeometry Figures="M2 5.5v-2A1.5 1.5 0 0 1 3.5 2h2M10.5 2h2A1.5 1.5 0 0 1 14 3.5v2M14 10.5v2a1.5 1.5 0 0 1-1.5 1.5h-2M5.5 14h-2A1.5 1.5 0 0 1 2 12.5v-2"/><RectangleGeometry Rect="5.2,5.2,5.6,5.6" RadiusX=".8" RadiusY=".8"/></GeometryGroup>
        <GeometryGroup x:Key="IconFolderGeometry"><PathGeometry Figures="M2 4.5A1.2 1.2 0 0 1 3.2 3.3h2.9l1.4 1.5h5.3A1.2 1.2 0 0 1 14 6v6a1.2 1.2 0 0 1-1.2 1.2H3.2A1.2 1.2 0 0 1 2 12z"/></GeometryGroup>
        <GeometryGroup x:Key="IconHelpGeometry"><EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6"/><PathGeometry Figures="M6.2 6.4a1.9 1.9 0 1 1 2.8 1.7c-.7.4-1 .8-1 1.6M8 11.7v.05"/></GeometryGroup>
        <GeometryGroup x:Key="IconImageGeometry"><RectangleGeometry Rect="2,3,12,10" RadiusX="1" RadiusY="1"/><EllipseGeometry Center="5.6,6.4" RadiusX="1" RadiusY="1"/><PathGeometry Figures="M2.4 12l3.6-3.6 2.4 2.4 2-2 3.2 3.2"/></GeometryGroup>
        <GeometryGroup x:Key="IconLinkGeometry"><PathGeometry Figures="M6.6 9.4a2.6 2.6 0 0 0 3.7 0l2.4-2.4a2.6 2.6 0 0 0-3.7-3.7l-.7.7M9.4 6.6a2.6 2.6 0 0 0-3.7 0L3.3 9a2.6 2.6 0 0 0 3.7 3.7l.7-.7"/></GeometryGroup>
        <GeometryGroup x:Key="IconMoreGeometry"><EllipseGeometry Center="3.5,8" RadiusX="1.15" RadiusY="1.15"/><EllipseGeometry Center="8,8" RadiusX="1.15" RadiusY="1.15"/><EllipseGeometry Center="12.5,8" RadiusX="1.15" RadiusY="1.15"/></GeometryGroup>
        <GeometryGroup x:Key="IconPinGeometry"><PathGeometry Figures="M5.2 2.5h5.6M6.4 2.5v4.2L4.6 9.2h6.8L9.6 6.7V2.5M8 9.2v4.6"/></GeometryGroup>
        <GeometryGroup x:Key="IconPulseGeometry"><PathGeometry Figures="M1.5 8.2h3l1.7-4.7 3.1 9 1.7-4.3h3.5"/></GeometryGroup>
        <GeometryGroup x:Key="IconRulerGeometry"><PathGeometry Figures="M2.2 10.8l8.6-8.6 3 3-8.6 8.6zM4.35 8.65l1.3 1.3M6.5 6.5l2 2M8.65 4.35l1.3 1.3"/></GeometryGroup>
        <GeometryGroup x:Key="IconSaveGeometry"><PathGeometry Figures="M3.2 2.5h7.6l2.7 2.7v7.3a1 1 0 0 1-1 1H3.2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1zM5 2.5v3.3h5.2V2.5M4.8 13.5V9.4h6.4v4.1"/></GeometryGroup>
        <GeometryGroup x:Key="IconSlidersGeometry"><PathGeometry Figures="M2 4.5h6M11.5 4.5H14M2 11.5h2.5M8 11.5h6"/><EllipseGeometry Center="9.8,4.5" RadiusX="1.6" RadiusY="1.6"/><EllipseGeometry Center="6.2,11.5" RadiusX="1.6" RadiusY="1.6"/></GeometryGroup>
        <GeometryGroup x:Key="IconSplitGeometry"><RectangleGeometry Rect="2,3,12,10" RadiusX="1" RadiusY="1"/><PathGeometry Figures="M8 3v10"/></GeometryGroup>
        <GeometryGroup x:Key="IconTrashGeometry"><PathGeometry Figures="M2.8 4.3h10.4M6 4.3V2.8h4v1.5M4.3 4.3l.6 8.7a.8.8 0 0 0 .8.7h4.6a.8.8 0 0 0 .8-.7l.6-8.7M6.8 7v4.2M9.2 7v4.2"/></GeometryGroup>
        <GeometryGroup x:Key="IconZoomInGeometry"><EllipseGeometry Center="7,7" RadiusX="4.6" RadiusY="4.6"/><PathGeometry Figures="M10.4 10.4L14 14M5 7h4M7 5v4"/></GeometryGroup>
        <GeometryGroup x:Key="IconZoomOutGeometry"><EllipseGeometry Center="7,7" RadiusX="4.6" RadiusY="4.6"/><PathGeometry Figures="M10.4 10.4L14 14M5 7h4"/></GeometryGroup>
        <Style x:Key="PrototypeIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <ControlTemplate x:Key="DockedCommandTemplate" TargetType="{x:Type ButtonBase}">
                <Grid>
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>

                    <Border x:Name="ButtonFocusBorder" BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></Trigger>

                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FF007ACC"/><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LinkBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource LinkBrush}"/></MultiDataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FFC42B1C"/><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ErrorTextBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ErrorTextBrush}"/><Setter Property="Foreground" Value="#1B1203"/></MultiDataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFocusBorder" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="BorderThickness" Value="0"/></MultiTrigger.Conditions><Setter Property="Opacity" Value="1"/></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource DockedCommandTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FF007ACC"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                <DataTrigger Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FFC42B1C"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FFC42B1C"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#1B1203"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToggleButton}">
                <Grid>
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <Border x:Name="CheckedBorder" BorderBrush="{DynamicResource StatusAccentBrush}" BorderThickness="1" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="ButtonFocusBorder" BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandPressedBrush}"/>
                                <Setter TargetName="CheckedBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/></Trigger>

                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FF007ACC"/></MultiDataTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LinkBrush}"/></MultiDataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FFC42B1C"/></MultiDataTrigger.Conditions><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ErrorTextBrush}"/></MultiDataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFocusBorder" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="{DynamicResource PanelBrush}"/>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{DynamicResource CommandBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource CommandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{DynamicResource SplitterBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SplitterHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InspectorRailButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid x:Name="RailBackground" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border x:Name="RailActiveLine" Width="2" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource StatusAccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="RailFocusBorder" BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailBackground" Property="Background" Value="{DynamicResource CommandHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="RailActiveLine" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RailFocusBorder" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ViewerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewerToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewerMenuToggle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerToggle}">
            <Setter Property="Template" Value="{StaticResource DockedCommandTemplate}"/>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource CommandHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ImageIconButton" TargetType="Button" BasedOn="{StaticResource ViewerButton}">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="24"/>
            <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Style.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></MultiTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImageIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerMenuToggle}">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="24"/>
            <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Style.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></MultiTrigger></Style.Triggers>
        </Style>
        <Style x:Key="MeasurementViewerToggle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerToggle}">
            <Setter Property="ToolTip" Value="{Binding MeasurementToolTip}"/>
            <Style.Triggers><DataTrigger Binding="{Binding CanMeasure}" Value="True"><Setter Property="ToolTip" Value="Click two image pixels to measure their horizontal and vertical distance (M)"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewerCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Border x:Name="CheckBorder" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border x:Name="CheckSelectionBorder" BorderBrush="{DynamicResource StatusAccentBrush}" BorderThickness="1" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="CheckFocusBorder" BorderBrush="{DynamicResource LinkBrush}" BorderThickness="2" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CommandPressedBrush}"/><Setter TargetName="CheckSelectionBorder" Property="Visibility" Value="Visible"/></Trigger>
