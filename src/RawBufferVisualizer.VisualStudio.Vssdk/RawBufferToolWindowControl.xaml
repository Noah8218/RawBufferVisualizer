                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <ContentControl x:Name="DockedInspectorHost" Grid.Column="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border x:Name="InspectorContainer" Width="300" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsOpen, Converter={StaticResource BooleanVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="12,0,6,0">
                            <Button DockPanel.Dock="Right" Content="»" MinWidth="28" Margin="0" Padding="4,0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseCommand}" ToolTip="Collapse inspector" AutomationProperties.Name="Collapse inspector" AutomationProperties.AutomationId="CollapseInspectorButton"/>
                            <TextBlock x:Name="InspectorPixelStateText" DockPanel.Dock="Right" Visibility="{Binding IsPixelSelected, Converter={StaticResource BooleanVisibility}}" Text="HOVER" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer x:Name="InspectorPanel" AutomationProperties.AutomationId="InspectorPanel" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                    <StackPanel x:Name="PixelSection" Visibility="{Binding IsPixelSelected, Converter={StaticResource BooleanVisibility}}">
<TextBlock x:Name="PixelHeadingText" Text="Pixel" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PixelText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PixelNeighborhoodHeadingText" Text="Hover 5x5 Values" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PixelNeighborhoodText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock x:Name="PixelStatsHeadingText" Text="Hover 5x5 Stats" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RoiStatsText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="Marker" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button ToolTip="Pin the selected or hovered pixel and freeze inspector values" AutomationProperties.Name="Pin marker" Click="PinMarker_Click">
                            <StackPanel Orientation="Horizontal"><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Pin}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Pin"/></StackPanel>
                        </Button>
                        <Button ToolTip="Clear pinned pixel" AutomationProperties.Name="Clear marker" Click="ClearMarker_Click">
                            <StackPanel Orientation="Horizontal"><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.ClearCollection}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Clear"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="MarkerText" AutomationProperties.AutomationId="MarkerText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Line" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LineProfileText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                    <StackPanel x:Name="HistogramSection" Visibility="{Binding IsHistogramSelected, Converter={StaticResource BooleanVisibility}}">
<presentation:HistogramView x:Name="HistogramPanel" Margin="0,14,0,0" Background="{DynamicResource InputBrush}"/>

                    <TextBlock Text="Display Range" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold" ToolTip="Display black/white range. Raw data is not changed." Visibility="Collapsed"/>
                    <Grid Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Black" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="BlackLevelTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="White" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WhiteLevelTextBox" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="2" Grid.Column="1">
                            <Button Content="Apply" Click="ApplyLevels_Click"/>
                            <Button Content="Auto" Click="AutoLevels_Click"/>
                        </WrapPanel>
                    </Grid>
                    </StackPanel>
                    <StackPanel x:Name="FormatSection" Visibility="{Binding IsFormatSelected, Converter={StaticResource BooleanVisibility}}">
<Border x:Name="AutomaticInspectionPanel"
                            Visibility="Collapsed"
                            Margin="0,0,0,12"
                            Padding="9"
                            Background="#252526"
                            BorderBrush="{StaticResource StatusAccentBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Automatic Vision Inspector" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AutomaticInspectionConfidenceText"
                                       Margin="0,5,0,0"
                                       Foreground="#9CDCFE"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="AutomaticInspectionMembersText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AutomaticInspectionValidationText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="EditAutomaticMappingButton"
                                    Content="Edit Mapping"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Left"
                                    ToolTip="Review inferred members and save corrections for this runtime type"
                                    AutomationProperties.AutomationId="EditAutomaticVisionMappingButton"
                                    Click="EditAutomaticMapping_Click"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DescriptorPanel" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10" MaxHeight="120">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Descriptor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DescriptorText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
<TextBlock Text="Interpret" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold"/>
                    <Grid x:Name="InterpretControls">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="InterpretPixelFormatBox" AutomationProperties.AutomationId="InterpretPixelFormatBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="InterpretWidthTextBox" AutomationProperties.AutomationId="InterpretWidthTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="InterpretHeightTextBox" AutomationProperties.AutomationId="InterpretHeightTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stride" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="InterpretStrideTextBox" AutomationProperties.AutomationId="InterpretStrideTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bits" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="InterpretValidBitsTextBox" AutomationProperties.AutomationId="InterpretValidBitsTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Endian" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="InterpretByteOrderBox" AutomationProperties.AutomationId="InterpretByteOrderBox" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="6" Grid.Column="1">
                            <Button x:Name="ApplyInterpretationButton" Content="Apply" AutomationProperties.AutomationId="ApplyInterpretationButton" Click="ApplyInterpretation_Click"/>
                            <Button x:Name="DiagnoseBufferButton" Content="Diagnose Buffer" AutomationProperties.AutomationId="DiagnoseBufferButton" ToolTip="Suggest ranked width/height/stride/pixel-format interpretations for this buffer" Click="DiagnoseBuffer_Click"/>
                        </WrapPanel>
                    </Grid>

                    <Border x:Name="DiagnosisPanel"
                            AutomationProperties.AutomationId="DiagnosisPanel"
                            Visibility="Collapsed"
                            Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="CloseDiagnosisButton" DockPanel.Dock="Right" Content="Close" Margin="0" Click="CloseDiagnosis_Click"/>
                                <TextBlock Text="Diagnose Buffer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="DiagnosisStatusText" AutomationProperties.AutomationId="DiagnosisStatusText" Margin="0,6,0,6" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                            <ListBox x:Name="DiagnosisCandidateList" AutomationProperties.AutomationId="DiagnosisCandidateList" MaxHeight="280" SelectionChanged="DiagnosisCandidateList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ToolTip="{Binding ReasonsText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="66" Height="50" Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource StatusAccentBrush}" Padding="6,1" CornerRadius="2" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AmbiguityNote}" FontSize="11" Foreground="#D7BA7D" TextWrapping="Wrap" Visibility="{Binding AmbiguityVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <StackPanel x:Name="CompareSection" Visibility="{Binding IsCompareSelected, Converter={StaticResource BooleanVisibility}}">
<TextBlock Text="Compare" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button Content="Set A" Click="SetCompareA_Click"/>
                        <Button Content="Set B" Click="SetCompareB_Click"/>
                        <Button Content="Split" Click="ShowSplit_Click"/>
                        <Button Content="Diff" Click="ShowDiff_Click"/>
                        <Button x:Name="BlinkButton" Content="Blink" Click="Blink_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="CompareText" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="DiagnosticsSection" Visibility="{Binding IsDiagnosticsSelected, Converter={StaticResource BooleanVisibility}}"><Border x:Name="EnvironmentCheckPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StatusAccentBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    AutomationProperties.Name="Raw Buffer Visualizer environment check"
                    AutomationProperties.AutomationId="EnvironmentCheckPanel">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Environment Check"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Checks the Visual Studio host, extension registration, and temporary storage."
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="EnvironmentVisualStudioText"
                                   AutomationProperties.AutomationId="EnvironmentVisualStudioStatus"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="EnvironmentExtensionText"
                                   AutomationProperties.AutomationId="EnvironmentExtensionStatus"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="EnvironmentTempStorageText"
                                   AutomationProperties.AutomationId="EnvironmentTempStorageStatus"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Refresh"
                                AutomationProperties.Name="Refresh environment check"
                                AutomationProperties.AutomationId="EnvironmentCheckRefreshButton"
                                Click="RefreshEnvironmentCheck_Click"/>
                        <Button Content="Copy diagnostic report"
                                AutomationProperties.Name="Copy environment diagnostic report"
                                AutomationProperties.AutomationId="EnvironmentCheckCopyReportButton"
                                Click="CopyEnvironmentReport_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
<TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button ToolTip="Copy diagnostics and environment details without image data" AutomationProperties.Name="Copy report" Click="CopySupportReport_Click">
                            <StackPanel Orientation="Horizontal"><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Copy}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Copy Report"/></StackPanel>
                        </Button>
                        <Button ToolTip="Write the current report and open its log folder" AutomationProperties.Name="Open logs" Click="OpenSupportLogs_Click">
                            <StackPanel Orientation="Horizontal"><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.OpenFolder}" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Open Logs"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="PerformanceText" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                    <ListBox x:Name="DiagnosticsList" Height="110"/>
                    <TextBlock x:Name="TempUsageText"


                           Margin="0,8,0,0"
                           VerticalAlignment="Center"

                           Foreground="{StaticResource StatusTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="TempUsageText"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </ContentControl>
            <StackPanel x:Name="InspectorRail" Grid.Column="5" Background="{DynamicResource PanelBrush}">
                <ToggleButton x:Name="InspectorPixelButton" IsChecked="{Binding IsPixelSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Pixel" AutomationProperties.Name="Pixel" AutomationProperties.AutomationId="InspectorPixelButton">
                    <StackPanel><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Inspect}" Width="18" Height="18" HorizontalAlignment="Center"/><TextBlock Text="Pixel" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorHistogramButton" IsChecked="{Binding IsHistogramSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Histogram" AutomationProperties.Name="Histogram" AutomationProperties.AutomationId="InspectorHistogramButton">
                    <StackPanel><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.HistogramVisualizer}" Width="18" Height="18" HorizontalAlignment="Center"/><TextBlock Text="Histo" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorFormatButton" IsChecked="{Binding IsFormatSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Buffer format" AutomationProperties.Name="Buffer format" AutomationProperties.AutomationId="InspectorFormatButton">
                    <StackPanel><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Property}" Width="18" Height="18" HorizontalAlignment="Center"/><TextBlock Text="Format" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorCompareButton" IsChecked="{Binding IsCompareSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Compare" AutomationProperties.Name="Compare" AutomationProperties.AutomationId="InspectorCompareButton">
                    <StackPanel><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.CompareFiles}" Width="18" Height="18" HorizontalAlignment="Center"/><TextBlock Text="Compare" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InspectorDiagnosticsButton" IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" Style="{StaticResource InspectorRailButtonStyle}"
                              ToolTip="Diagnostics" AutomationProperties.Name="Diagnostics" AutomationProperties.AutomationId="InspectorDiagnosticsButton">
                    <StackPanel><imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StartGraphicDiagnostics}" Width="18" Height="18" HorizontalAlignment="Center"/><TextBlock Text="Diag" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                </ToggleButton>
            </StackPanel>
            <Popup x:Name="InspectorOverlayPopup" PlacementTarget="{Binding ElementName=InspectorRail}" Placement="Left" AllowsTransparency="True" StaysOpen="True"/>
            </Grid>




        </Grid>

    </Grid>
</UserControl>
