<UserControl x:Class="RawBufferVisualizer.VisualStudio.Vssdk.RawBufferToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gl="clr-namespace:RawBufferVisualizer.OpenGlCanvas;assembly=RawBufferVisualizer.OpenGlCanvas"
             MinWidth="420"
             MinHeight="260"
             Background="#1E1E1E"
             SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="CommandBrush" Color="#333337"/>
        <SolidColorBrush x:Key="CommandHoverBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="CommandPressedBrush" Color="#094771"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CDCFE"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#252526"/>
        <SolidColorBrush x:Key="StatusAccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="StatusTextBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ChannelChipBrush" Color="#303033"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="SplitterHoverBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#B5CEA8"/>
        <SolidColorBrush x:Key="AttentionTextBrush" Color="#D7BA7D"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1C97EA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CommandPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1C97EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="{StaticResource PanelBrush}"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource StatusAccentBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CommandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SplitterHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" Margin="0,0,6,0" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ZoomText" Width="58" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Open" Click="Open_Click"/>
                    <Button Content="Clear" Click="Clear_Click"/>
                    <Button Content="Save" AutomationProperties.AutomationId="SaveVisiblePngButton" Click="SaveVisiblePng_Click"/>
                    <Button Content="Fit" Click="Fit_Click"/>
                    <Button Content="1:1" Click="ActualSize_Click"/>
                    <CheckBox x:Name="LinkViewsBox" Content="Link Views" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" Checked="LinkViewsBox_Changed" Unchecked="LinkViewsBox_Changed"/>
                    <CheckBox x:Name="SelectionOverlayBox" Content="Selection" AutomationProperties.AutomationId="SelectionOverlayBox" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Checked="SelectionOverlayBox_Changed" Unchecked="SelectionOverlayBox_Changed"/>
                    <ToggleButton x:Name="InspectorToggleButton" Content="Inspector" Visibility="Collapsed" Checked="InspectorToggleButton_Changed" Unchecked="InspectorToggleButton_Changed"/>
                    <Button x:Name="WhatsNewButton"
                            Content="What's New"
                            ToolTip="Show the current Raw Buffer Visualizer release highlights"
                            AutomationProperties.Name="Show release highlights"
                            AutomationProperties.AutomationId="ReleaseAnnouncementOpenButton"
                            Click="WhatsNew_Click"/>
                    <Button x:Name="EnvironmentCheckButton"
                            Content="Environment"
                            ToolTip="Check runtime compatibility and optional contributor utilities"
                            AutomationProperties.Name="Open environment check"
                            AutomationProperties.AutomationId="EnvironmentCheckOpenButton"
                            Click="EnvironmentCheck_Click"/>
                    <Slider x:Name="ZoomSlider" Visibility="Collapsed" Width="1" Minimum="0.01" Maximum="16" Value="1" TickFrequency="0.1" ValueChanged="ZoomSlider_ValueChanged"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <Border x:Name="ReleaseAnnouncementBanner"
                    Visibility="Collapsed"
                    Background="#17384A"
                    BorderBrush="#2B88B8"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    AutomationProperties.Name="Raw Buffer Visualizer release highlights"
                    AutomationProperties.AutomationId="ReleaseAnnouncementBanner">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="12,0,0,0">
                        <Button Content="View release notes"
                                ToolTip="Open the complete release notes in your browser"
                                AutomationProperties.Name="View release notes"
                                AutomationProperties.AutomationId="ReleaseAnnouncementNotesButton"
                                Click="ViewReleaseNotes_Click"/>
                        <Button Content="Dismiss"
                                Margin="0"
                                ToolTip="Hide these highlights for this version"
                                AutomationProperties.Name="Dismiss release highlights"
                                AutomationProperties.AutomationId="ReleaseAnnouncementDismissButton"
                                Click="DismissReleaseAnnouncement_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ReleaseAnnouncementTitleText"
                                   AutomationProperties.AutomationId="ReleaseAnnouncementTitle"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReleaseAnnouncementHighlightOneText"
                                   Margin="0,4,0,0"
                                   Foreground="#D8EEF8"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReleaseAnnouncementHighlightTwoText"
                                   Margin="0,2,0,0"
                                   Foreground="#D8EEF8"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReleaseAnnouncementHighlightThreeText"
                                   Margin="0,2,0,0"
                                   Foreground="#D8EEF8"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="EnvironmentCheckPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StatusAccentBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    AutomationProperties.Name="Raw Buffer Visualizer environment check"
                    AutomationProperties.AutomationId="EnvironmentCheckPanel">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Environment Check"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Runtime requirements are listed before optional contributor and media tools."
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="EnvironmentVisualStudioText"
                                   AutomationProperties.AutomationId="EnvironmentVisualStudioStatus"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="EnvironmentExtensionText"
                                   AutomationProperties.AutomationId="EnvironmentExtensionStatus"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="EnvironmentTempStorageText"
                                   AutomationProperties.AutomationId="EnvironmentTempStorageStatus"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="Optional contributor/media tools"
                               Margin="0,10,0,4"
                               FontWeight="SemiBold"/>

                    <Border Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="6"
                            Margin="0,0,0,4">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Official download"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Open the official .NET 8 download page"
                                    AutomationProperties.AutomationId="EnvironmentDotNetDownloadButton"
                                    Click="OpenDotNetDownload_Click"/>
                            <TextBlock x:Name="EnvironmentDotNetText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="6"
                            Margin="0,0,0,4">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Open VS Installer"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Open Visual Studio Installer"
                                    AutomationProperties.AutomationId="EnvironmentVisualStudioInstallerButton"
                                    Click="OpenVisualStudioInstaller_Click"/>
                            <TextBlock x:Name="EnvironmentVisualStudioWorkloadText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Installation guide"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Open the official FFmpeg installation guide"
                                    AutomationProperties.AutomationId="EnvironmentFfmpegGuideButton"
                                    Click="OpenFfmpegGuide_Click"/>
                            <TextBlock x:Name="EnvironmentFfmpegText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Refresh"
                                AutomationProperties.Name="Refresh environment check"
                                AutomationProperties.AutomationId="EnvironmentCheckRefreshButton"
                                Click="RefreshEnvironmentCheck_Click"/>
                        <Button Content="Copy diagnostic report"
                                AutomationProperties.Name="Copy environment diagnostic report"
                                AutomationProperties.AutomationId="EnvironmentCheckCopyReportButton"
                                Click="CopyEnvironmentReport_Click"/>
                        <Button Content="Close"
                                AutomationProperties.Name="Close environment check"
                                AutomationProperties.AutomationId="EnvironmentCheckCloseButton"
                                Click="CloseEnvironmentCheck_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="CompactInspectorSplitterRow" Height="Auto"/>
                <RowDefinition x:Name="CompactInspectorRow" Height="0" MinHeight="0" MaxHeight="360"/>
            </Grid.RowDefinitions>

            <Grid x:Name="MainContentGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ImagesColumn" Width="320" MinWidth="160"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="140"/>
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="5"/>
                    <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="0"/>
                </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,10,10,6">
                    <TextBlock Text="Images" FontSize="16" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,5,0,0">
                        <CheckBox x:Name="AutoInspectBox"
                                  Content="Auto Inspect on Break"
                                  IsChecked="True"
                                  Foreground="{StaticResource TextBrush}"
                                  VerticalAlignment="Center"
                                  ToolTip="Refresh image-like locals and arguments on Break. This choice is saved; the Tool Window is never forced open."
                                  AutomationProperties.Name="Automatic Vision Inspector"
                                  AutomationProperties.AutomationId="AutomaticVisionAutoInspectCheckBox"
                                  Checked="AutoInspectBox_Changed"
                                  Unchecked="AutoInspectBox_Changed"/>
                        <Button Content="Scan Now"
                                Margin="6,0,0,0"
                                ToolTip="Scan the current stack frame without waiting for another break"
                                AutomationProperties.AutomationId="AutomaticVisionScanNowButton"
                                Click="ScanNow_Click"/>
                    </WrapPanel>
                    <CheckBox x:Name="IncludeImageCollectionsBox"
                              Content="Mat collections"
                              IsChecked="False"
                              Margin="18,4,0,0"
                              Foreground="{StaticResource TextBrush}"
                              VerticalAlignment="Center"
                              ToolTip="Inspect exact OpenCvSharp/Emgu Mat List and one-dimensional array values. Up to 8 items per collection and 16 per scan. This choice is saved."
                              AutomationProperties.Name="Include Mat collections"
                              AutomationProperties.AutomationId="AutomaticVisionIncludeCollectionsCheckBox"
                              Checked="IncludeImageCollectionsBox_Changed"
                              Unchecked="IncludeImageCollectionsBox_Changed"/>
                    <TextBlock x:Name="AutomaticFrameText"
                               Text="Current stack frame"
                               Margin="0,6,0,0"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="AutomaticScanStatusText"
                               Text="Automatic inspection is ready."
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="#9CDCFE"
                               TextWrapping="Wrap"/>
                </StackPanel>

                    <ListBox Grid.Row="1" Margin="10,0,10,10" x:Name="ImageList" SelectionChanged="ImageList_SelectionChanged" KeyDown="ImageList_KeyDown" ContextMenuOpening="ImageListContextMenu_Opening">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Save visible PNG" Click="SaveVisiblePng_Click"/>
                                <MenuItem Header="Save raw snapshot" Click="SaveSnapshot_Click"/>
                                <MenuItem x:Name="OpenVariableMenuItem" Header="Open Variable..." AutomationProperties.AutomationId="OpenVariableMenuItem" Click="OpenVariable_Click"/>
                                <MenuItem x:Name="MapThisTypeMenuItem" Header="Map This Type" AutomationProperties.AutomationId="MapThisTypeMenuItem" Visibility="Collapsed" Click="MapThisType_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="66" Height="50" Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Map"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding MappingActionVisibility}"
                                            ToolTip="Confirm only the unresolved member or pixel-format mapping"
                                            AutomationProperties.Name="Map this detected image type"
                                            Click="MapCandidate_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                <Border x:Name="DescriptorPanel" Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10" MaxHeight="120">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Descriptor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DescriptorText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="ImagesGridSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2">
                <Border Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0">
                    <gl:RawOpenGlImageCanvas x:Name="OpenGlImageView" AutomationProperties.AutomationId="RawBufferOpenGlImageView"/>
                </Border>
                <Border x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        Panel.ZIndex="2"
                        MaxWidth="560"
                        Margin="12"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#252526"
                        BorderBrush="#C94B4B"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Image could not be visualized" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ErrorIdText" Margin="0,5,0,0" Foreground="#F48771" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock x:Name="ErrorMessageText" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="120"/>
                        <TextBlock Text="The report contains diagnostics and environment details, but no image payload." Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="CopyErrorReportButton" Content="Copy Report" AutomationProperties.AutomationId="CopyErrorReportButton" Click="CopySupportReport_Click"/>
                            <Button x:Name="OpenErrorLogsButton" Content="Open Logs" AutomationProperties.AutomationId="OpenErrorLogsButton" Click="OpenSupportLogs_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="InspectorGridSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <ScrollViewer x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource PanelBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <Border x:Name="AutomaticInspectionPanel"
                            Visibility="Collapsed"
                            Margin="0,0,0,12"
                            Padding="9"
                            Background="#252526"
                            BorderBrush="{StaticResource StatusAccentBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Automatic Vision Inspector" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AutomaticInspectionConfidenceText"
                                       Margin="0,5,0,0"
                                       Foreground="#9CDCFE"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="AutomaticInspectionMembersText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AutomaticInspectionValidationText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="EditAutomaticMappingButton"
                                    Content="Edit Mapping"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Left"
                                    ToolTip="Review inferred members and save corrections for this runtime type"
                                    AutomationProperties.AutomationId="EditAutomaticVisionMappingButton"
                                    Click="EditAutomaticMapping_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PixelHeadingText" Text="Pixel" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PixelText" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PixelNeighborhoodHeadingText" Text="Hover 5x5 Values" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PixelNeighborhoodText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock x:Name="PixelStatsHeadingText" Text="Hover 5x5 Stats" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RoiStatsText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="Marker" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button Content="Pin" ToolTip="Pin the selected or hovered pixel and freeze inspector values" Click="PinMarker_Click"/>
                        <Button Content="Clear" ToolTip="Clear pinned pixel" Click="ClearMarker_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="MarkerText" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Line" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LineProfileText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>

                    <TextBlock Text="Histogram" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold"/>
                    <Border Height="110" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource InputBrush}">
                        <Canvas x:Name="HistogramCanvas" Margin="8"/>
                    </Border>

                    <TextBlock Text="Display Range" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold" ToolTip="Display black/white range. Raw data is not changed." Visibility="Collapsed"/>
                    <Grid Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Black" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="BlackLevelTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="White" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WhiteLevelTextBox" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="2" Grid.Column="1">
                            <Button Content="Apply" Click="ApplyLevels_Click"/>
                            <Button Content="Auto" Click="AutoLevels_Click"/>
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="Interpret" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="InterpretPixelFormatBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="InterpretWidthTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="InterpretHeightTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stride" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="InterpretStrideTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bits" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="InterpretValidBitsTextBox" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Endian" Margin="0,0,8,6"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="InterpretByteOrderBox" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="6" Grid.Column="1">
                            <Button Content="Apply" Click="ApplyInterpretation_Click"/>
                            <Button x:Name="DiagnoseBufferButton" Content="Diagnose Buffer" AutomationProperties.AutomationId="DiagnoseBufferButton" ToolTip="Suggest ranked width/height/stride/pixel-format interpretations for this buffer" Click="DiagnoseBuffer_Click"/>
                        </WrapPanel>
                    </Grid>

                    <Border x:Name="DiagnosisPanel"
                            Visibility="Collapsed"
                            Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="CloseDiagnosisButton" DockPanel.Dock="Right" Content="Close" Margin="0" Click="CloseDiagnosis_Click"/>
                                <TextBlock Text="Diagnose Buffer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="DiagnosisStatusText" Margin="0,6,0,6" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                            <ListBox x:Name="DiagnosisCandidateList" AutomationProperties.AutomationId="DiagnosisCandidateList" MaxHeight="280" SelectionChanged="DiagnosisCandidateList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ToolTip="{Binding ReasonsText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="66" Height="50" Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource StatusAccentBrush}" Padding="6,1" CornerRadius="2" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AmbiguityNote}" FontSize="11" Foreground="#D7BA7D" TextWrapping="Wrap" Visibility="{Binding AmbiguityVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Compare" Margin="0,14,0,8" FontSize="14" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button Content="Set A" Click="SetCompareA_Click"/>
                        <Button Content="Set B" Click="SetCompareB_Click"/>
                        <Button Content="Split" Click="ShowSplit_Click"/>
                        <Button Content="Diff" Click="ShowDiff_Click"/>
                        <Button x:Name="BlinkButton" Content="Blink" Click="Blink_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="CompareText" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

                    <TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="Copy Report" ToolTip="Copy diagnostics and environment details without image data" Click="CopySupportReport_Click"/>
                        <Button Content="Open Logs" ToolTip="Write the current report and open its log folder" Click="OpenSupportLogs_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="PerformanceText" Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                    <ListBox x:Name="DiagnosticsList" Height="110"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <GridSplitter x:Name="CompactInspectorGridSplitter"
                          Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="Collapsed"/>

            <Border x:Name="CompactInspectorPanel"
                    Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8"
                    MaxHeight="360"
                    Visibility="Collapsed">
                <TabControl x:Name="CompactInspectorTabs">
                    <TabItem Header="Pixel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock x:Name="CompactPixelHeadingText" Text="Current" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="CompactPixelText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="36"/>
                                    <TextBlock x:Name="CompactPixelNeighborhoodHeadingText" Text="Hover 5x5 Values" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="CompactPixelNeighborhoodText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="CompactPixelStatsHeadingText" Text="Hover 5x5 Stats" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="CompactRoiStatsText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Text="Marker" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <WrapPanel>
                                        <Button Content="Pin" ToolTip="Pin the selected or hovered pixel and freeze inspector values" Click="PinMarker_Click"/>
                                        <Button Content="Clear" ToolTip="Clear pinned pixel" Click="ClearMarker_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="CompactMarkerText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="38"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Range" Visibility="Collapsed">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Black" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CompactBlackLevelTextBox" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="White" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompactWhiteLevelTextBox" Margin="0,0,8,6"/>
                            <WrapPanel Grid.Row="2" Grid.Column="1">
                                <Button Content="Apply" Click="ApplyCompactLevels_Click"/>
                                <Button Content="Auto" Click="AutoLevels_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Interpret">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" Margin="0,0,8,6"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CompactInterpretPixelFormatBox" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Width" Margin="0,0,8,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompactInterpretWidthTextBox" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Height" Margin="0,0,8,6"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CompactInterpretHeightTextBox" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Stride" Margin="0,0,8,6"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="CompactInterpretStrideTextBox" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Bits" Margin="0,0,8,6"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="CompactInterpretValidBitsTextBox" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Endian" Margin="0,0,8,6"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CompactInterpretByteOrderBox" Margin="0,0,0,6"/>
                                    <WrapPanel Grid.Row="6" Grid.Column="1">
                                        <Button x:Name="CompactApplyInterpretationButton" Content="Apply" Click="ApplyInterpretation_Click"/>
                                        <Button x:Name="CompactDiagnoseBufferButton" Content="Diagnose Buffer" AutomationProperties.AutomationId="CompactDiagnoseBufferButton" ToolTip="Suggest ranked width/height/stride/pixel-format interpretations for this buffer" Click="DiagnoseBuffer_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Border x:Name="CompactDiagnosisPanel"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0"
                                        Padding="8"
                                        Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="CompactCloseDiagnosisButton" DockPanel.Dock="Right" Content="Close" Margin="0" Click="CloseDiagnosis_Click"/>
                                            <TextBlock Text="Diagnose Buffer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock x:Name="CompactDiagnosisStatusText" Margin="0,6,0,6" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                                        <ListBox x:Name="CompactDiagnosisCandidateList" AutomationProperties.AutomationId="CompactDiagnosisCandidateList" MaxHeight="220" SelectionChanged="DiagnosisCandidateList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" ToolTip="{Binding ReasonsText}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="66" Height="50" Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <DockPanel LastChildFill="True">
                                                                <Border DockPanel.Dock="Right" Background="{StaticResource StatusAccentBrush}" Padding="6,1" CornerRadius="2" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding AmbiguityNote}" FontSize="11" Foreground="#D7BA7D" TextWrapping="Wrap" Visibility="{Binding AmbiguityVisibility}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Copy Report" ToolTip="Copy diagnostics and environment details without image data" Click="CopySupportReport_Click"/>
                                    <Button Content="Open Logs" ToolTip="Write the current report and open its log folder" Click="OpenSupportLogs_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="CompactPerformanceText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ElementName=DiagnosticsList, Path=Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="3" Height="28" Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource StatusAccentBrush}" BorderThickness="0,1,0,0" Padding="8,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Width="220"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Foreground="{StaticResource StatusTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TempUsageText"
                           DockPanel.Dock="Right"
                           Width="92"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Foreground="{StaticResource StatusTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="TempUsageText"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PixelPositionText" Text="X -  Y -" FontSize="11" Foreground="{StaticResource StatusTextBrush}" VerticalAlignment="Center" MinWidth="76"/>
                    <TextBlock Text="|" FontSize="11" Foreground="#5A5A5A" Margin="8,0"/>

                    <Border x:Name="PixelValueChip" Background="{StaticResource ChannelChipBrush}" BorderBrush="#444444" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="PixelSwatch" Width="12" Height="12" Margin="0,0,4,0" Background="#1E1E1E" BorderBrush="#AAAAAA" BorderThickness="1"/>
                            <TextBlock x:Name="PixelValueText" Text="GV -" FontSize="11" Foreground="{StaticResource StatusTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="PixelChannelsPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Background="{StaticResource ChannelChipBrush}" BorderBrush="#444444" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PixelRSwatch" Width="12" Height="12" Margin="0,0,4,0" Background="#550000" BorderBrush="#AAAAAA" BorderThickness="1"/>
                                <TextBlock x:Name="PixelRText" Text="R -" FontSize="11" Foreground="{StaticResource StatusTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ChannelChipBrush}" BorderBrush="#444444" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PixelGSwatch" Width="12" Height="12" Margin="0,0,4,0" Background="#005500" BorderBrush="#AAAAAA" BorderThickness="1"/>
                                <TextBlock x:Name="PixelGText" Text="G -" FontSize="11" Foreground="{StaticResource StatusTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ChannelChipBrush}" BorderBrush="#444444" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PixelBSwatch" Width="12" Height="12" Margin="0,0,4,0" Background="#000055" BorderBrush="#AAAAAA" BorderThickness="1"/>
                                <TextBlock x:Name="PixelBText" Text="B -" FontSize="11" Foreground="{StaticResource StatusTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PixelAChip" Background="{StaticResource ChannelChipBrush}" BorderBrush="#444444" BorderThickness="1" Padding="4,1" Margin="0,0,4,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PixelASwatch" Width="12" Height="12" Margin="0,0,4,0" Background="#555555" BorderBrush="#AAAAAA" BorderThickness="1"/>
                                <TextBlock x:Name="PixelAText" Text="A -" FontSize="11" Foreground="{StaticResource StatusTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="PixelColorText" Text="RGB -" Visibility="Collapsed"/>
                    <TextBlock Text="|" FontSize="11" Foreground="#5A5A5A" Margin="8,0"/>
                    <TextBlock x:Name="PixelRawText" Text="Bytes -" FontSize="11" Foreground="{StaticResource StatusTextBrush}" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
