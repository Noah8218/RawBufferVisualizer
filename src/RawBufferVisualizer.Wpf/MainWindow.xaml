<Window x:Class="RawBufferVisualizer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:RawBufferVisualizer.Presentation"
        xmlns:gl="clr-namespace:RawBufferVisualizer.OpenGlCanvas;assembly=RawBufferVisualizer.OpenGlCanvas"
        Title="Raw Buffer Visualizer" Width="1280" Height="800" MinWidth="920" MinHeight="620"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/RawBufferVisualizerDark.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style TargetType="Button" BasedOn="{StaticResource RbvButtonStyle}"/>
            <Style TargetType="ListBox" BasedOn="{StaticResource RbvListBoxStyle}"/>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RbvListBoxItemStyle}"/>
            <Style TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource RbvScrollBarStyle}"/>
            <Style x:Key="DescriptorValue" TargetType="TextBlock" BasedOn="{StaticResource RbvTextBlockStyle}"><Setter Property="Margin" Value="8,4,0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>
    <DockPanel Background="{StaticResource RbvWindowBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,10,10,4">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Open" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="OpenButton"/>
                    <Button Content="Open example" Command="{Binding OpenExampleCommand}" AutomationProperties.AutomationId="OpenExampleButton"/>
                    <Button Content="Export PNG" Command="{Binding SavePngCommand}" AutomationProperties.AutomationId="SavePngButton"/>
                    <Button Content="Export Snapshot" Command="{Binding SaveSnapshotCommand}" AutomationProperties.AutomationId="SaveSnapshotButton"/>
                    <Button Content="Open copy" Command="{Binding DuplicateCommand}" AutomationProperties.AutomationId="DuplicateButton"/>
                    <Button Content="Close (Ctrl+W)" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="CloseDocumentButton"/>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Fit" Command="{Binding FitCommand}" AutomationProperties.AutomationId="FitButton"/>
                    <Button Content="1:1" Command="{Binding ActualSizeCommand}" AutomationProperties.AutomationId="ActualSizeButton"/>
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,8,6"/>
                    <Slider x:Name="ZoomSlider" Width="160" Minimum="0.01" Maximum="16" Value="{Binding ZoomScale, Mode=TwoWay}" IsEnabled="{Binding HasImage}" Margin="0,0,8,6" AutomationProperties.AutomationId="ZoomSlider"/>
                    <TextBlock x:Name="ZoomText" Text="{Binding ZoomText}" MinWidth="64" VerticalAlignment="Center" Margin="0,0,12,6" AutomationProperties.AutomationId="ZoomText"/>
                    <ToggleButton x:Name="LinkViewsBox" Content="Link views" IsChecked="{Binding LinkViews, Mode=TwoWay}" IsEnabled="{Binding HasImage}" Style="{StaticResource RbvToggleButtonStyle}" AutomationProperties.AutomationId="LinkViewsBox"/>
                    <TextBlock x:Name="StatusText" Text="{Binding ImageStatus}" VerticalAlignment="Center" Margin="8,0,0,6" Foreground="{StaticResource RbvMutedTextBrush}" AutomationProperties.AutomationId="StatusText"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6" Background="{StaticResource RbvPanelBrush}">
            <StackPanel>
                <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ActionStatus" Text="{Binding ActionStatus}" AutomationProperties.AutomationId="ActionStatus"/>
                </ScrollViewer>
                <TextBlock Text="{Binding PngAvailability}" Foreground="{StaticResource RbvAttentionTextBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource RbvPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Images" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="ImageList" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}" Height="240" AutomationProperties.AutomationId="ImageList">
                            <ListBox.InputBindings><KeyBinding Key="Delete" Command="{Binding CloseCommand}"/></ListBox.InputBindings>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="62" Height="48" Background="#111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource RbvMutedTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Descriptor" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Width (px)" VerticalAlignment="Center"/><TextBlock x:Name="WidthBox" Grid.Column="1" Text="{Binding WidthText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="WidthBox"/>
                            <TextBlock Grid.Row="1" Text="Height (px)" VerticalAlignment="Center"/><TextBlock x:Name="HeightBox" Grid.Row="1" Grid.Column="1" Text="{Binding HeightText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="HeightBox"/>
                            <TextBlock Grid.Row="2" Text="Stride (bytes)" VerticalAlignment="Center"/><TextBlock x:Name="StrideBox" Grid.Row="2" Grid.Column="1" Text="{Binding StrideText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="StrideBox"/>
                            <TextBlock Grid.Row="3" Text="Pixel format" VerticalAlignment="Center"/><TextBlock x:Name="FormatBox" Grid.Row="3" Grid.Column="1" Text="{Binding FormatText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="FormatBox"/>
                            <TextBlock Grid.Row="4" Text="Valid bits" VerticalAlignment="Center"/><TextBlock x:Name="ValidBitsBox" Grid.Row="4" Grid.Column="1" Text="{Binding ValidBitsText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="ValidBitsBox"/>
                            <TextBlock Grid.Row="5" Text="Byte order" VerticalAlignment="Center"/><TextBlock x:Name="ByteOrderBox" Grid.Row="5" Grid.Column="1" Text="{Binding ByteOrderText}" Style="{StaticResource DescriptorValue}" AutomationProperties.AutomationId="ByteOrderBox"/>
                        </Grid>
                        <TextBlock Text="File" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <TextBlock x:Name="FileText" Text="{Binding FileText}" Foreground="{StaticResource RbvMutedTextBrush}" AutomationProperties.AutomationId="FileText"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#111111">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ListBox x:Name="DocumentTabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False" SelectionChanged="DocumentTabs_SelectionChanged" SizeChanged="DocumentTabs_SizeChanged"
                             Visibility="{Binding HasDocuments, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.AutomationId="DocumentTabs">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel MaxWidth="240">
                                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="6,0,0,0" MinHeight="24"
                                        Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}" ToolTip="Close document"/>
                                <TextBlock Text="{Binding Title}" MaxWidth="192" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <gl:RawOpenGlImageCanvas Grid.Row="1" x:Name="OpenGlImageView" AutomationProperties.AutomationId="ImageView" Visibility="{Binding HasImage, Converter={StaticResource VisibleWhenTrue}}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel x:Name="EmptyState" Margin="24" VerticalAlignment="Center" AutomationProperties.AutomationId="EmptyState">
                            <TextBlock Text="Inspect a buffer" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Open .rbuf.json with its companion RAW file to restore the correct image settings." Margin="0,0,0,12"/>
                            <TextBlock Text="For .raw or .bin data, enter width, height, stride and pixel format before viewing. PNG and JPEG are not supported inputs." Margin="0,0,0,16"/>
                            <WrapPanel><Button Content="Open a file" Command="{Binding OpenCommand}"/><Button Content="Open example" Command="{Binding OpenExampleCommand}"/></WrapPanel>
                            <TextBlock Text="You can also drop supported files here. Select an image to inspect pixels and its histogram." Foreground="{StaticResource RbvMutedTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource RbvPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Pixel" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PixelText" Text="{Binding PixelText}" Margin="0,6,0,14" Foreground="{StaticResource RbvMutedTextBrush}" AutomationProperties.AutomationId="PixelText"/>
                        <presentation:HistogramView x:Name="HistogramPanel" DataContext="{Binding Histogram}" Background="{StaticResource RbvWindowBrush}"/>
                        <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock x:Name="DiagnosticSummary" Text="{Binding DiagnosticSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="DiagnosticsList" ItemsSource="{Binding Diagnostics}" AutomationProperties.AutomationId="DiagnosticsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
